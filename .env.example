# ── AWS Core ──────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Bedrock — ONE knowledge base for ALL countries ────────────────────────
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_MODEL_ARN=arn:aws:bedrock:eu-west-1::foundation-model/anthropic.claude-3-haiku-20240307-v1:0

# ── Bedrock Guardrails ────────────────────────────────────────────────────
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ── ElastiCache Redis ─────────────────────────────────────────────────────
ELASTICACHE_URL=redis://your-elasticache-endpoint:6379

# ── S3 Config URIs — point these at your S3 bucket ───────────────────────
COUNTRY_CONFIG_S3_URI=s3://your-bucket/config/countries.json
COMPLIANCE_MESSAGES_S3_URI=s3://your-bucket/i18n/compliance-messages.json
HEALTH_FOOTERS_S3_URI=s3://your-bucket/i18n/health-footers.json

# ── Admin dashboard ───────────────────────────────────────────────────────
ADMIN_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001